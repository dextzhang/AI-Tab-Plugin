{
  "manifest_version": 3,
  "name": "AI2tab",
  "version": "1.1",
  "description": "在一个页面发送消息到多个AI模型网页",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://x.ai/*",
    "*://grok.com/*",
    "*://tongyi.aliyun.com/*",
    "*://www.doubao.com/*",
    "*://kimi.moonshot.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
